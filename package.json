{
  "name": "scoreboard-app",
  "version": "1.0.0",
  "description": "Desktop Scoreboard App with OBS Overlay",
  "author": "Janindu",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix frontend\" \"electron .\"",
    "dev:concurrently": "concurrently \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\" \"cross-env ELECTRON_NO_BACKEND=1 electron .\"",
    "build:ui": "npm run build --prefix frontend",
    "build": "npm run build:ui && node node_modules/electron-builder/out/cli/cli.js"
  },
  "dependencies": {
    "concurrently": "^8.2.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "mongodb": "^6.19.0",
    "mongoose": "^8.18.1",
    "mongoose-sequence": "^6.0.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "29.4.0",
    "electron-builder": "24.13.3",
    "rimraf": "^6.0.1"
  },
  "build": {
    "appId": "com.scoreboard.app",
    "productName": "ScoreboardApp",
    "files": [
      "main.js",
      "package.json",
      "frontend/dist/**"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend"
      }
    ],
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    }
  }
}
