{
  "name": "scoreboard-app",
  "version": "1.0.0",
  "description": "Desktop Scoreboard App with OBS Overlay",
  "author": "Janindu",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix frontend\" \"electron .\"",
    "build:ui": "npm run build --prefix frontend",
    "prep:backend": "npm ci --prefix backend || npm i --prefix backend",
    "pack:win": "npm run build:ui && npm run prep:backend && electron-builder --win nsis",
    "build": "npm run build:ui && npm run prep:backend && electron-builder"
  },
  "dependencies": {
    "concurrently": "^8.2.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "29.4.0",
    "electron-builder": "24.13.3",
    "rimraf": "^6.0.1"
  },
  "build": {
    "appId": "com.scoreboard.app",
    "productName": "ScoreboardApp",
    "asar": true,
    "files": [
      "main.js",
      "package.json",
      "frontend/dist/**"
    ],
    "extraResources": [
      { "from": "backend", "to": "backend" },
      { "from": "frontend/dist", "to": "frontend_dist" }
    ],
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "artifactName": "ScoreboardApp-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
